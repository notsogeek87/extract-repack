<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No storage/internet permissions declared on purpose:
        - File access goes exclusively through the Storage Access
          Framework (ACTION_OPEN_DOCUMENT / ACTION_OPEN_DOCUMENT_TREE),
          which needs no runtime permission at all.
        - The app never makes a network request (see docs/ANALYSIS.md,
          requirement "aucune connexion Internet nécessaire").
    -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArcExtract">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.ArcExtract">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
